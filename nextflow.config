manifest {
    name = 'PanPhyloFlow'
    author = 'Muhammad Bilal'
    homePage = 'https://github.com/mbilal-OU/PanPhyloFlow'
    description = 'Teaching-oriented microbial gene-family pangenome and core-phylogeny workflow'
    mainScript = 'main.nf'
    version = '0.2.0'
    nextflowVersion = '>=24.10.0'
}

params {
    input = null
    input_type = 'fasta'
    outdir = 'results'
    pangenome = 'roary'
    threads = 4
    core_threshold = 0.95
    panaroo_clean_mode = 'strict'
    panaroo_family_threshold = 0.70
    roary_identity = 95
    ufboot = 1000
    sh_alrt = 1000
}

process {
    executor = 'local'
    // 'terminate' stops the run on the first task failure. Note: maxRetries
    // only applies to the 'retry' strategy and is intentionally not set here.
    errorStrategy = 'terminate'

    withLabel: annotation {
        cpus = params.threads
        memory = '8 GB'
    }

    withLabel: pangenome {
        cpus = params.threads
        memory = '16 GB'
    }

    withLabel: phylogeny {
        cpus = params.threads
        memory = '16 GB'
    }

    withLabel: reporting {
        cpus = 1
        memory = '4 GB'
    }
}

profiles {
    conda {
        conda.enabled = true
        // Bioconda solves (notably Prokka) are slow or failure-prone with the
        // classic solver; mamba/libmamba resolves them reliably.
        conda.useMamba = true
    }

    ci {
        process {
            withLabel: annotation {
                cpus = 1
                memory = '1 GB'
            }
            withLabel: pangenome {
                cpus = 1
                memory = '1 GB'
            }
            withLabel: phylogeny {
                cpus = 1
                memory = '1 GB'
            }
            withLabel: reporting {
                cpus = 1
                memory = '1 GB'
            }
        }
    }
}

report {
    enabled = true
    file = "${params.outdir}/nextflow_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/execution_trace.tsv"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/dag.html"
    overwrite = true
}
