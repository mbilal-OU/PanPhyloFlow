// CI-only config for the weekly real-data smoke test
// (.github/workflows/real-data-smoke.yml). Supplied via `-c`; the
// repository's own nextflow.config is NOT modified.
//
// Overrides vs the repo `conda` profile: use micromamba (provided by
// mamba-org/setup-micromamba) instead of mamba, and size processes for a
// GitHub-hosted runner (4 CPUs / 16 GB RAM).

conda {
    enabled       = true
    useMamba      = false
    useMicromamba = true
}

process {
    withLabel: annotation {
        cpus   = 2
        memory = '6 GB'
    }
    withLabel: pangenome {
        cpus   = 2
        memory = '6 GB'
    }
    withLabel: phylogeny {
        cpus   = 2
        memory = '6 GB'
    }
    withLabel: reporting {
        cpus   = 1
        memory = '2 GB'
    }
}
